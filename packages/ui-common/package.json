{
  "name": "@itookit/ui-common",
  "version": "0.1.0",
  "description": "Shared UI components, contracts, and browser utilities for the itookit ecosystem.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/stdio": "workspace:*"
  },
  "devDependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/stdio": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {}
}
