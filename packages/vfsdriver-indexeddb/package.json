{
    "name": "@itookit/vfsdriver-indexeddb",
    "version": "5.3.0",
    "description": "IndexedDB storage backend for @itookit/vfs-core — persistent browser-side VFS driver.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.cjs",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "import": {
                    "types": "./dist/index.d.ts",
                    "default": "./dist/index.js"
                },
                "require": {
                    "types": "./dist/index.d.cts",
                    "default": "./dist/index.cjs"
                }
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "pnpm build",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "itookit",
        "vfs",
        "indexeddb",
        "storage",
        "browser"
    ],
    "author": "lizlok@gmail.com",
    "license": "MIT",
    "dependencies": {
        "@itookit/vfs-core": "workspace:*"
    },
    "devDependencies": {
        "fake-indexeddb": "^6.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/mushuanli/itookit.git",
        "directory": "packages/vfsdriver-indexeddb"
    },
    "bugs": {
        "url": "https://github.com/mushuanli/itookit/issues"
    },
    "homepage": "https://github.com/mushuanli/itookit/tree/main/packages/vfsdriver-indexeddb#readme"
}
