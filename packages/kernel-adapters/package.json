{
  "name": "@itookit/kernel-adapters",
  "version": "0.1.0",
  "description": "Kernel capability adapters for LLM, tools, skills, Bash, and TTY",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./llm": {
      "types": "./src/llm-management/index.ts",
      "import": "./src/llm-management/index.ts",
      "default": "./src/llm-management/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./llm": {
        "types": "./dist/llm.d.ts",
        "import": "./dist/llm.js",
        "require": "./dist/llm.cjs"
      }
    },
    "imports": {
      "#mcp-stdio": {
        "browser": "./dist/mcp-stdio-browser.js",
        "default": "./dist/mcp-stdio.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/driver-llm": "workspace:*",
    "@itookit/durable-kernel": "workspace:*",
    "@itookit/vfs-core": "workspace:*",
    "@itookit/tools": "workspace:*",
    "@itookit/llm-context": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0",
    "@types/js-yaml": "^4.0.9",
    "@itookit/vfsdriver-indexeddb": "workspace:*"
  },
  "imports": {
    "#mcp-stdio": {
      "browser": "./src/llm-management/skills/mcp-stdio-browser.ts",
      "default": "./src/llm-management/skills/mcp-stdio.ts"
    }
  }
}
