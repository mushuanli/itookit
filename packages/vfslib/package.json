{
    "name": "@itookit/vfslib",
    "version": "0.1.0",
    "description": "Virtual filesystem core library for the itookit ecosystem. Provides VFS engine, mount router, plugin pipeline, device manager, and module-isolated filesystem operations.",
    "type": "module",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./backend": {
            "types": "./src/backend/index.ts",
            "import": "./src/backend/index.ts",
            "default": "./src/backend/index.ts"
        },
        "./testing": {
            "types": "./src/testing/index.ts",
            "import": "./src/testing/index.ts",
            "default": "./src/testing/index.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "main": "./dist/index.js",
        "module": "./dist/index.mjs",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.mjs",
                "require": "./dist/index.js"
            },
            "./backend": {
                "types": "./dist/backend/index.d.ts",
                "import": "./dist/backend/index.mjs",
                "require": "./dist/backend/index.js"
            },
            "./testing": {
                "types": "./dist/testing/index.d.ts",
                "import": "./dist/testing/index.mjs",
                "require": "./dist/testing/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "itookit",
        "vfs",
        "virtual-filesystem",
        "storage"
    ],
    "author": "lizlok@gmail.com",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/mushuanli/itookit.git",
        "directory": "packages/vfslib"
    },
    "bugs": {
        "url": "https://github.com/mushuanli/itookit/issues"
    },
    "homepage": "https://github.com/mushuanli/itookit/tree/main/packages/vfslib#readme",
    "dependencies": {
        "@itookit/common": "workspace:*",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@itookit/vfsdriver-indexeddb": "workspace:*",
        "@itookit/vfsdriver-localfs": "workspace:*",
        "fake-indexeddb": "^6.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}