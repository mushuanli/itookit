{
  "name": "@itookit/coreutils",
  "version": "0.1.0",
  "description": "Harness capability adapters for LLM, tools, skills, Bash, and TTY",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@itookit/common": "workspace:*",
    "@itookit/device-llm": "workspace:*",
    "@itookit/harness": "workspace:*",
    "@itookit/stdio": "workspace:*",
    "@itookit/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "rimraf": "^5.0.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
