{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@itookit/common": ["../../packages/common/src/index.ts"],
      "@itookit/common/*": ["../../packages/common/src/*"],
      "@itookit/vfslib": ["../../packages/vfslib/src/index.ts"],
      "@itookit/vfsdriver-indexeddb": ["../../packages/vfsdriver-indexeddb/src/index.ts"],
      "@itookit/vfs-ui": ["../../packages/vfs-ui/src/index.ts"],
      "@itookit/mdxeditor": ["../../packages/mdx/src/index.ts"],
      "@itookit/memory-manager": ["../../packages/memory-manager/src/index.ts"],
      "@itookit/device-llm": ["../../packages/device-llm/src/index.ts"],
      "@itookit/llm-kernel": ["../../packages/llm-kernel/src/index.ts"],
      "@itookit/llm-engine": ["../../packages/llm-engine/src/index.ts"],
      "@itookit/llm-ui": ["../../packages/llm-ui/src/index.ts"],
      "@itookit/app-settings": ["../../packages/app-settings/src/index.ts"]
    }
  },
  "include": [
    "src",
    // Ambient module declarations from workspace packages that have no @types coverage.
    // Needed because web-app compiles package sources directly via `paths` aliases.
    "../../packages/mdx/src/types"
  ],
  "exclude": ["node_modules", "dist"]
}