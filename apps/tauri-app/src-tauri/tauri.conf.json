{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "X1",
    "version": "0.1.0",
    "identifier": "com.itookit.x1",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title":           "X1",
                "width":           1280,
                "height":          800,
                "minWidth":        800,
                "minHeight":       600,
                "resizable":       true,
                "fullscreen":      false,
                "decorations":     true,
                "transparent":     false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: blob: data: http://asset.localhost; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active":  true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.png"
        ]
    }
}
