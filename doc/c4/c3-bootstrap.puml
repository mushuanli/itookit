@startuml C3_Bootstrap_Layer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - 引导与应用层组件图 (v4.1 优化后)

Container_Boundary(bootstrap, "引导与应用层") {

  ' ======== app-shell ========
  Container_Boundary(app_shell, "app-shell — 应用引导") {
    Component(init_app, "initApp()", "bootstrap.ts", "顶层引导函数（唯一入口）\n注入 LLMUIEditors 给 app-settings")
    Component(ws_strategies, "StandardWorkspaceStrategy\nChatWorkspaceStrategy\nSettingsWorkspaceStrategy", "strategies/", "工作区策略模式")
    Component(ws_consts, "WS_SETTINGS / WS_CHAT\nWS_AGENTS / WS_MINDS\nWS_ANKI / WS_PROJECTS\nWS_EMAILS / WS_SKILLS\nWS_HOME", "workspaces/", "10 个工作区常量")
    Component(file_registry, "FILE_REGISTRY", "config/", "文件扩展名 ↔ 编辑器工厂注册表")
    Component(theme_svc, "themeService", "config/", "主题服务 (亮色/暗色)")
    Component(skill_sync, "syncSkillsToHarness()", "bootstrap.ts", "Skill 直通同步\n(LLMSkill = SkillDefinition)")

    Rel(init_app, ws_strategies, "路由请求", "getFactory()/getEngine()")
    Rel(ws_strategies, ws_consts, "使用工作区定义", "")
    Rel(init_app, skill_sync, "步骤7: 同步", "直接传递 SkillDefinition")
  }

  ' ======== app-settings ========
  Container_Boundary(settings, "app-settings — 设置模块") {
    Component(settings_module, "createSettingsModule()", "factories/", "初始化设置模块")
    Component(settings_engine, "SettingsEngine", "engine/", "设置读取/写入引擎")
    Component(skills_engine, "SkillsEngine", "engine/", "技能引擎 (导入/导出/启用/禁用)")
    Component(system_vfs, "SystemVFSEngine", "engine/", "跨模块只读 VFS 浏览")
    Component(llm_ui_editors, "LLMUIEditors 接口\n(Provider/Connection\nMCP/Cost)", "factories/", "llm-ui 编辑器注入点\n(无上行依赖)")

    Rel(settings_module, settings_engine, "创建", "")
    Rel(settings_module, skills_engine, "创建", "")
    Rel(settings_engine, system_vfs, "使用", "跨模块浏览")
    Rel(settings_module, llm_ui_editors, "接收注入", "app-shell → app-settings")
  }

  ' ======== demo ========
  Container_Boundary(demo_app, "demo — 开发演示") {
    Component(demo_html, "index.html", "", "入口 HTML 页面")
    Component(demo_app_main, "app.js", "", "演示应用逻辑（JavaScript）")

    Rel(demo_html, demo_app_main, "加载", "")
  }
}

' === 引导序列 ===
Rel_B(init_app, settings_module, "步骤3: 初始化设置", "createSettingsModule(vfs)")
Rel_B(init_app, ws_strategies, "步骤8: 路由策略", "")
Rel(ws_strategies, settings_module, "设置工作区使用", "")

' === 外部依赖 ===
System_Ext(common_pkg, "@itookit/common", "SkillDefinition(统一) · IConnectionReader · i18n")
System_Ext(vfs_pkg, "@itookit/stdio", "VFS 引擎")
System_Ext(driver_pkg, "@itookit/device-llm", "LLM 驱动\n(getSkills→SkillDefinition[])")
System_Ext(harness_pkg, "@itookit/llm-harness", "Agent 循环")
System_Ext(engine_pkg, "@itookit/llm-runtime", "会话引擎")
System_Ext(memory_pkg, "@itookit/memory-manager", "工作区容器")
System_Ext(vfsui_pkg, "@itookit/vfs-ui", "文件树 UI")
System_Ext(llmui_pkg, "@itookit/llm-ui", "Chat UI\n(编辑器注入至 app-settings)")
System_Ext(mdx_pkg, "@itookit/mdxeditor", "MDX 编辑器")

' === 引导依赖 ===
Rel(init_app, vfs_pkg, "步骤1: createVFS()", "")
Rel(init_app, driver_pkg, "步骤2: new LLMDeviceDriver()", "")
Rel(init_app, harness_pkg, "步骤5: createHarness()", "")
Rel(init_app, engine_pkg, "步骤7: initializeLLMEngine()", "")
Rel(init_app, memory_pkg, "步骤8: new MemoryManager()", "惰性创建")
Rel(init_app, vfsui_pkg, "步骤8: createVFSUI()", "")
Rel(init_app, llmui_pkg, "步骤8: 创建工厂 + 编辑器注入", "createLLMFactory()")
Rel(init_app, mdx_pkg, "步骤8: defaultEditorFactory", "")
Rel(init_app, common_pkg, "基础依赖", "接口/类型/i18n")

' app-shell 从 llm-ui 取编辑器类，注入给 app-settings
Rel(init_app, llmui_pkg, "导入编辑器类", "ProviderSettingsEditor\nConnectionSettingsEditor\nMCPSettingsEditor\nCostEditor")
Rel(init_app, settings_module, "注入 LLMUIEditors", "createSettingsFactory(..., llmUiEditors)")

@enduml
