@startuml C3_UI_Layer
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C3 - UI 层组件图 (v4.1 优化后)

Container_Boundary(ui, "UI 层 (llm-ui + vfs-ui + mdxeditor + memory-manager)") {

  ' ======== mdxeditor ========
  Container_Boundary(mdx_editor, "mdxeditor — MDX 编辑器") {
    Component(mdx_core, "MDxEditor", "core/", "CodeMirror 6 编辑器核心")
    Component(mdx_renderer, "MDxRenderer", "renderer/", "Markdown 渲染器（编辑/预览双模式）")
    Component(mdx_processor, "MDxProcessor", "services/", "MDX 处理服务")
    Component(plugin_manager, "PluginManager", "core/", "插件注册与管理")
    Component(plugins, "CoreEditorPlugin\nFoldablePlugin\nMathJaxPlugin\nMediaPlugin\nSvgPlugin\nMermaidPlugin\n...", "plugins/", "20+ 语法扩展插件")
    Component(ed_factory, "defaultEditorFactory", "core/", "默认 EditorFactory")
    Component(srs_types, "SRSItemData / ISRSService\nSRSCardRef / SRSStats", "types/srs.ts", "SRS 接口 (从 common 移入)")

    Rel(mdx_core, plugin_manager, "加载插件", "")
    Rel(plugin_manager, plugins, "管理", "20+ 插件")
    Rel(mdx_core, mdx_renderer, "切换模式", "编辑/预览")
    Rel(mdx_core, mdx_processor, "处理内容", "")
    Rel(plugins, srs_types, "记忆插件消费", "memory.plugin.ts")
  }

  ' ======== vfs-ui ========
  Container_Boundary(vfsui, "vfs-ui — VFS 文件树 UI") {
    Component(vfs_shell, "VFSUIShell", "shell/", "文件树导航外壳 (ISessionUI)")
    Component(vfs_service, "VFSService", "services/", "文件操作服务")
    Component(mention_src, "FileMentionSource\nDirectoryMentionSource\nEngineTagSource", "mention/", "@mention 文件补全")
    Component(autocomplete, "IAutocompleteSource\nIMentionSource\nSuggestion / HoverPreviewData", "mention/", "自动完成接口 (从 common 移入)")
    Component(file_type_reg, "FileTypeRegistry", "services/", "文件类型注册")
    Component(editor_lifecycle, "connectEditorLifecycle()", "integrations/", "VFS-UI ↔ 编辑器生命周期桥接")

    Rel(vfs_shell, vfs_service, "操作文件", "")
    Rel(vfs_shell, mention_src, "mention 补全", "")
    Rel(mention_src, vfs_service, "搜索文件", "")
    Rel(mention_src, autocomplete, "继承基类", "BaseMentionSource")
    Rel(vfs_service, file_type_reg, "类型识别", "")
  }

  ' ======== llm-ui ========
  Container_Boundary(llmui, "llm-ui — Chat UI") {
    Component(chat_input, "ChatInput / AIContextMenu", "components/", "对话输入组件/AI右键菜单")
    Component(settings_editors, "ConnectionSettingsEditor\nProviderSettingsEditor\nMCPSettingsEditor\nCostEditor", "components/", "设置编辑器系列\n(通过 LLMUIEditors 注入 app-settings)")
    Component(session_svc, "SessionService", "services/", "会话数据服务")
    Component(workspace_factory, "createLLMFactory()", "shell/", "LLM 工作区工厂函数")

    Rel(chat_input, session_svc, "发送/接收消息", "")
    Rel(settings_editors, session_svc, "读取配置", "")
  }

  ' ======== memory-manager ========
  Container_Boundary(mem_mgr, "memory-manager — 工作区容器") {
    Component(memory_manager, "MemoryManager", "core/", "工作区顶层容器（一个实例=一个标签页）")
    Component(background_brain, "BackgroundBrain", "core/", "AI 后台处理")

    Rel(memory_manager, vfs_shell, "组装侧边栏", "VFSUIShell")
    Rel(memory_manager, mdx_core, "组装编辑器", "MDxEditor")
    Rel(memory_manager, background_brain, "后台 AI", "")
  }
}

' === 外部组件引用 ===
System_Ext(business_layer, "业务层", "llm-engine / app-settings")
System_Ext(engine_layer, "引擎层", "vfslib / device-llm")

Rel_R(session_svc, business_layer, "会话状态", "SessionManager")
Rel_R(vfs_shell, engine_layer, "文件操作", "IModuleFS")
Rel_R(mdx_core, engine_layer, "文件读写", "IModuleFS")
' app-settings 不直接依赖 llm-ui 编辑器 —— 由 app-shell 注入
Rel_R(settings_editors, business_layer, "注入到 app-settings", "LLMUIEditors")
Rel_R(background_brain, business_layer, "AI 处理", "SessionManager")

@enduml
